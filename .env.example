# Environment Configuration Template (Zero secrets in frontend)
# All secret keys (e.g. OpenAI API, DB connection string) reside strictly in the backend server.
# Point at the EduSearch Nest API (local PORT, or your ngrok URL).
# Must be a Nest process that serves POST /api/chat (not an old build).
NEXT_PUBLIC_API_URL=http://localhost:3000
USE_MOCK=false